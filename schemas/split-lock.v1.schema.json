{
  "$id": "urn:outervoid:dataset:split-lock.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "type": "string"
    },
    "records": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "content_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "since": {
            "type": "string"
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "test",
              "holdout",
              "adversarial",
              "regression"
            ]
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ]
          }
        },
        "required": [
          "split",
          "content_sha256",
          "status",
          "since"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[a-z]{2}:[a-z0-9][a-z0-9-]{1,62}:[0-9]{2}$"
      },
      "type": "object"
    },
    "schema": {
      "const": "blux.dataset-split-lock"
    }
  },
  "required": [
    "schema",
    "dataset",
    "records"
  ],
  "type": "object"
}
