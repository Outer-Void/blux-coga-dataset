{
  "$id": "urn:outervoid:dataset:config.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "enum": [
        "coga",
        "ca"
      ]
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "canary": {
      "pattern": "^[0-9a-f-]{36}$",
      "type": "string"
    },
    "card": {
      "additionalProperties": false,
      "properties": {
        "intended_use": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "out_of_scope": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pretty_name": {
          "type": "string"
        },
        "record_format": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "pretty_name",
        "tags",
        "record_format",
        "intended_use",
        "out_of_scope",
        "limitations"
      ],
      "type": "object"
    },
    "categories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "dataset_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "type": "string"
    },
    "engines": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "commit": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "package",
          "version",
          "commit"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "id_prefix": {
      "pattern": "^[a-z]{2}$",
      "type": "string"
    },
    "license": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "spdx": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "spdx",
        "name"
      ],
      "type": "object"
    },
    "near_duplicate_threshold": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "type": "number"
    },
    "quality_threshold": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "release_date": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "schema": {
      "const": "blux.dataset-config"
    },
    "summary": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "dataset_id",
    "title",
    "version",
    "release_date",
    "summary",
    "license",
    "authors",
    "adapter",
    "engines",
    "id_prefix",
    "categories",
    "canary",
    "quality_threshold",
    "near_duplicate_threshold",
    "card"
  ],
  "type": "object"
}
